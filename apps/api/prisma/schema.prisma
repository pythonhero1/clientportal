datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Owner
  Client
}

enum AccountStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProjectStatus {
  ONBOARDING
  ACTIVE
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum WebsiteEnvironment {
  STAGING
  PRODUCTION
}

enum WebsiteStatus {
  DRAFT
  LIVE
  MAINTENANCE
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  AWAITING_REVIEW
  APPROVED
}

enum DriveDocumentCategory {
  BRIEF
  SPECIFICATION
  BRAND_GUIDELINES
  CONTRACT
  OTHER
}

enum OnboardingStepKey {
  CONTACT_DETAILS
  QUESTIONNAIRE
  BRAND_ASSETS
  CONTENT_UPLOAD
  ACCESS_CREDENTIALS
  KICKOFF_APPROVAL
}

enum StepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  AWAITING_REVIEW
}

enum CredentialShareMethod {
  COLLABORATOR_INVITE
  BITWARDEN_SEND
  DIRECT_DELEGATION
}

enum CredentialShareStatus {
  REQUESTED
  INVITATION_SENT
  SEND_LINK_PROVIDED
  RECEIVED_AND_VERIFIED
  REVOKED
}

enum FileCategory {
  IMAGES
  DOCUMENTS
  SPREADSHEETS
  DESIGN_FILES
  ARCHIVES
  VIDEO
  AUDIO
}

enum FileLifecycleStatus {
  ACTIVE
  ARCHIVED
  SOFT_DELETED
  RESTRICTED_POST_WINDOW
  PERMANENTLY_DELETED
}

enum FileVisibility {
  SHARED
  INTERNAL
}

enum VersionReviewStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum ScanStatus {
  QUARANTINED
  CLEAN
  INFECTED
  FAILED
}

model User {
  id           String              @id @default(cuid())
  clerkUserId  String              @unique
  email        String              @unique
  name         String?
  role         Role                @default(Client)
  status       AccountStatus       @default(PENDING_APPROVAL)
  mfaEnforced  Boolean             @default(false)
  profile      Profile?
  memberships  ProjectMembership[]
  sentInvites      Invitation[]        @relation("InvitedBy")
  auditActions     AuditLog[]          @relation("ActorUser")
  createdFiles     File[]              @relation("CreatedFiles")
  uploadedVersions FileVersion[]       @relation("UploadedFileVersions")
  approvedVersions FileVersion[]       @relation("ApprovedFileVersions")
  fileComments     FileComment[]       @relation("AuthorFileComments")
  createdConversations Conversation[]   @relation("CreatedConversations")
  conversationMemberships ConversationMembership[]
  sentMessages     Message[]           @relation("SentMessages")
  clientInvoices   Invoice[]           @relation("ClientInvoices")
  createdInvoices  Invoice[]           @relation("CreatedInvoices")
  recordedPayments PaymentRecord[]     @relation("RecordedPayments")
  clientMeetings   Meeting[]           @relation("ClientMeetings")
  notifications    Notification[]      @relation("UserNotifications")
  pushSubscriptions PushSubscription[] @relation("UserPushSubscriptions")
  notificationPreferences UserNotificationPreferences?
  clientTickets    Ticket[]            @relation("ClientTickets")
  assignedTickets  Ticket[]            @relation("AssignedTickets")
  ticketMessages   TicketMessage[]     @relation("AuthorTicketMessages")
  authoredArticles HelpArticle[]       @relation("AuthoredArticles")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([clerkUserId])
  @@index([email])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  companyName String?
  avatarUrl   String?
  timezone    String   @default("Africa/Lagos")
  themePreference String @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                 String                    @id @default(cuid())
  name               String
  description        String?
  status             ProjectStatus             @default(ONBOARDING)
  kickoffApprovedAt  DateTime?
  kickoffApprovedById String?
  kickoffNotes       String?
  memberships        ProjectMembership[]
  invitations        Invitation[]
  websites           Website[]
  milestones         Milestone[]
  documents          DriveDocument[]
  onboardingSteps    OnboardingStep[]
  questionnaire      QuestionnaireResponse?
  credentialRequests CredentialAccessRequest[]
  files              File[]
  conversations      Conversation[]
  invoices           Invoice[]
  meetings           Meeting[]
  tickets            Ticket[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Website {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  url         String
  environment WebsiteEnvironment @default(STAGING)
  status      WebsiteStatus      @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([projectId])
}

model Milestone {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  orderIndex   Int             @default(0)
  status       MilestoneStatus @default(PLANNED)
  dueDate      DateTime?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId])
}

model DriveDocument {
  id               String                @id @default(cuid())
  projectId        String
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  driveUrl         String
  category         DriveDocumentCategory @default(OTHER)
  sharedStatusNote String?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([projectId])
}

model OnboardingStep {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey       OnboardingStepKey
  status        StepStatus        @default(NOT_STARTED)
  completedAt   DateTime?
  completedById String?
  metadata      Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([projectId, stepKey])
  @@index([projectId])
}

model QuestionnaireResponse {
  id          String    @id @default(cuid())
  projectId   String    @unique
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String?
  data        Json      @default("{}")
  isDraft     Boolean   @default(true)
  submittedAt DateTime?
  lastSavedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CredentialAccessRequest {
  id            String                @id @default(cuid())
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platformName  String
  method        CredentialShareMethod @default(COLLABORATOR_INVITE)
  status        CredentialShareStatus @default(REQUESTED)
  instructions  String?
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([projectId])
}

model ProjectMembership {
  id                         String   @id @default(cuid())
  projectId                  String
  project                    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDesignatedBillingContact Boolean  @default(false)
  isDesignatedApprover       Boolean  @default(false)
  joinedAt                   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Invitation {
  id                         String    @id @default(cuid())
  token                      String    @unique
  email                      String
  role                       Role      @default(Client)
  projectId                  String?
  project                    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isDesignatedBillingContact Boolean   @default(false)
  isDesignatedApprover       Boolean   @default(false)
  status                     String    @default("PENDING")
  invitedById                String
  invitedBy                  User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt                  DateTime
  acceptedAt                 DateTime?
  createdAt                  DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorUser", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model File {
  id                    String              @id @default(cuid())
  projectId             String
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User                @relation("CreatedFiles", fields: [createdById], references: [id])
  name                  String
  category              FileCategory
  visibility            FileVisibility      @default(SHARED)
  lifecycleStatus       FileLifecycleStatus @default(ACTIVE)
  archivedAt            DateTime?
  archivedById          String?
  softDeletedAt         DateTime?
  softDeletedById       String?
  softDeleteExpiresAt   DateTime?
  permanentlyDeletedAt  DateTime?
  permanentlyDeletedById String?
  currentVersionNumber  Int                 @default(1)
  versions              FileVersion[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([projectId])
  @@index([lifecycleStatus])
}

model FileVersion {
  id             String              @id @default(cuid())
  fileId         String
  file           File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNumber  Int
  storageKey     String
  quarantineKey  String?
  fileName       String
  fileExtension  String
  mimeType       String
  byteSize       BigInt
  checksumSha256 String?
  scanStatus     ScanStatus          @default(QUARANTINED)
  scanResult     String?
  isLatest       Boolean             @default(true)
  uploadedById   String
  uploadedBy     User                @relation("UploadedFileVersions", fields: [uploadedById], references: [id])
  reviewStatus   VersionReviewStatus @default(PENDING_REVIEW)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?               @relation("ApprovedFileVersions", fields: [approvedById], references: [id])
  approvalNotes  String?
  comments       FileComment[]
  messageAttachments MessageAttachment[]
  createdAt      DateTime            @default(now())

  @@unique([fileId, versionNumber])
  @@index([fileId])
}

model FileComment {
  id            String      @id @default(cuid())
  fileVersionId String
  fileVersion   FileVersion @relation(fields: [fileVersionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("AuthorFileComments", fields: [authorId], references: [id])
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([fileVersionId])
}

enum ConversationType {
  PROJECT
  DIRECT
  GENERAL
  GROUP
}

enum ConversationMemberRole {
  Owner
  Member
}

model Conversation {
  id            String                   @id @default(cuid())
  type          ConversationType         @default(DIRECT)
  title         String?
  projectId     String?
  project       Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User                     @relation("CreatedConversations", fields: [createdById], references: [id])
  lastMessageAt DateTime?
  memberships   ConversationMembership[]
  messages      Message[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([projectId])
  @@index([type])
  @@index([lastMessageAt])
}

model ConversationMembership {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationMemberRole @default(Member)
  joinedAt       DateTime               @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([joinedAt])
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation("SentMessages", fields: [senderId], references: [id])
  content        String              @db.Text
  idempotencyKey String?
  attachments    MessageAttachment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id            String       @id @default(cuid())
  messageId     String
  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileVersionId String
  fileVersion   FileVersion  @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())

  @@index([messageId])
  @@index([fileVersionId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  GATEWAY_ONLINE
  MANUAL_ADJUSTMENT
}

enum PaymentRecordStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String?       @unique
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId      String
  client        User          @relation("ClientInvoices", fields: [clientId], references: [id])
  createdById   String
  createdBy     User          @relation("CreatedInvoices", fields: [createdById], references: [id])
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")
  subtotal      Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @default(0.00) @db.Decimal(5, 2)
  taxAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0.00) @db.Decimal(12, 2)
  dueDate       DateTime
  issuedAt      DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text
  pdfStorageKey String?
  items         InvoiceItem[]
  payments      PaymentRecord[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId])
  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1.00) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([invoiceId])
}

model PaymentRecord {
  id              String              @id @default(cuid())
  invoiceId       String
  invoice         Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  method          PaymentMethod       @default(BANK_TRANSFER)
  status          PaymentRecordStatus @default(PENDING)
  reference       String?
  evidenceNote    String?             @db.Text
  proofStorageKey String?
  recordedById    String
  recordedBy      User                @relation("RecordedPayments", fields: [recordedById], references: [id])
  confirmedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([invoiceId])
  @@index([status])
}

enum MeetingStatus {
  ACCEPTED
  RESCHEDULED
  CANCELLED
  REJECTED
}

model Meeting {
  id                 String        @id @default(cuid())
  calBookingUid      String        @unique
  calBookingId       String?
  projectId          String?
  project            Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId           String?
  client             User?         @relation("ClientMeetings", fields: [clientId], references: [id], onDelete: SetNull)
  title              String
  description        String?       @db.Text
  status             MeetingStatus @default(ACCEPTED)
  startTime          DateTime
  endTime            DateTime
  timezone           String        @default("Africa/Lagos")
  meetingUrl         String?
  rescheduleUrl      String?
  cancelUrl          String?
  cancellationReason String?       @db.Text
  rescheduledFromUid String?
  rescheduledToUid   String?
  attendees          Json?
  metadata           Json?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([projectId])
  @@index([clientId])
  @@index([startTime])
  @@index([status])
}

enum NotificationType {
  FILE_DELIVERABLE_UPLOADED
  FILE_CHANGES_REQUESTED
  FILE_APPROVED
  FILE_SOFT_DELETED
  FILE_RESTORED
  FILE_PERMANENTLY_DELETED
  MESSAGE_RECEIVED
  INVOICE_ISSUED
  PAYMENT_CONFIRMED
  MILESTONE_UPDATED
  MEETING_SCHEDULED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_RESOLVED
  SYSTEM_ALERT
}

enum TicketStatus {
  OPEN
  WAITING_FOR_OWNER
  WAITING_FOR_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserNotificationPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppDeliverables       Boolean  @default(true)
  inAppMessages           Boolean  @default(true)
  inAppInvoices           Boolean  @default(true)
  inAppMilestones         Boolean  @default(true)
  inAppMeetings           Boolean  @default(true)
  inAppSupport            Boolean  @default(true)
  pushEnabled             Boolean  @default(false)
  pushDeliverables        Boolean  @default(true)
  pushMessages            Boolean  @default(true)
  pushInvoices            Boolean  @default(true)
  pushMilestones          Boolean  @default(true)
  pushMeetings            Boolean  @default(true)
  pushSupport             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Ticket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  clientId     String
  client       User            @relation("ClientTickets", fields: [clientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subject      String
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(NORMAL)
  assignedToId String?
  assignedTo   User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("AuthorTicketMessages", fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([authorId])
}

model HelpCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  orderIndex  Int           @default(0)
  articles    HelpArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model HelpArticle {
  id          String        @id @default(cuid())
  categoryId  String
  category    HelpCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  slug        String        @unique
  content     String        @db.Text
  excerpt     String?
  isPublished Boolean       @default(true)
  publishedAt DateTime?
  orderIndex  Int           @default(0)
  authorId    String?
  author      User?         @relation("AuthoredArticles", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([isPublished])
}


