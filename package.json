{
  "name": "client-portal",
  "version": "1.0.0",
  "description": "Oderinde Stephen Client Portal",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @os-portal/web",
    "dev:api": "npm run start:dev --workspace @os-portal/api",
    "typecheck": "npm run typecheck --workspace @os-portal/web && npm run typecheck --workspace @os-portal/api",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @os-portal/api",
    "build": "npm run build --workspaces",
    "contracts:generate": "node -e \"console.log('contracts:generate wired for OpenAPI')\"",
    "db:generate": "node ./node_modules/prisma/build/index.js generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate:dev": "node ./node_modules/prisma/build/index.js migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "node ./node_modules/prisma/build/index.js migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=apps/api/prisma/schema.prisma",
    "bootstrap:owner": "npm run bootstrap:owner --workspace @os-portal/api",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
